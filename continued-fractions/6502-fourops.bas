10 B=4*ATN(1)
20 PRINT "TARGET"
30 Z=B
40 GOSUB 900
50 P0=0:P1=1:Q0=1:Q1=0
60 FOR N=0 TO 9
70 K=N:GOSUB 1000
80 P=A*P1+P0
90 Q=A*Q1+Q0
100 X=P/Q
110 IF B<>X THEN 150
120 PRINT "FOUND";N
130 Z=X
140 GOSUB 900:END
150 P0=P1:P1=P:Q0=Q1:Q1=Q
160 NEXT N
170 PRINT "FOUND NONE"
180 END
900 V=PEEK(123)+256*PEEK(124)
910 FOR I=2 TO 5
920 PRINT PEEK(V+I);
930 NEXT I
940 PRINT
950 RETURN
1000 IF K=0 THEN A=3:RETURN
1010 IF K=1 THEN A=7:RETURN
1020 IF K=2 THEN A=15:RETURN
1030 IF K=3 THEN A=1:RETURN
1040 IF K=4 THEN A=435:RETURN
1050 IF K=5 THEN A=1:RETURN
1060 IF K=6 THEN A=2:RETURN
1070 IF K=7 THEN A=1:RETURN
1080 IF K=8 THEN A=6:RETURN
1090 A=3
1100 RETURN
