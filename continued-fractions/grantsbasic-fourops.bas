10 B=3.1415927
20 PRINT "TARGET"
30 PRINT B
40 P0=0:P1=1:Q0=1:Q1=0
50 FOR N=0 TO 9
60 K=N:GOSUB 1000
70 P=A*P1+P0
80 Q=A*Q1+Q0
90 X=P/Q
100 IF B<>X THEN 140
110 PRINT "FOUND";N
120 PRINT X
130 END
140 P0=P1:P1=P:Q0=Q1:Q1=Q
150 NEXT N
160 PRINT "FOUND NONE"
170 END
1000 IF K=0 THEN A=3:RETURN
1010 IF K=1 THEN A=7:RETURN
1020 IF K=2 THEN A=15:RETURN
1030 IF K=3 THEN A=1:RETURN
1040 IF K=4 THEN A=435:RETURN
1050 IF K=5 THEN A=1:RETURN
1060 IF K=6 THEN A=2:RETURN
1070 IF K=7 THEN A=1:RETURN
1080 IF K=8 THEN A=6:RETURN
1090 A=3
1100 RETURN
