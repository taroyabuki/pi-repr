10 DEFDBL A-Z
20 S=0#
30 FOR K=11 TO 9 STEP -1
40 S=1#/(2#*K+1#)-.04#*S
50 NEXT K
60 PRINT "S9";
70 Z=S:GOSUB 300
80 A=1#/17#
90 PRINT "A";
100 Z=A:GOSUB 300
110 B=.04#*S
120 PRINT "B";
130 Z=B:GOSUB 300
140 C=A-B
150 PRINT "C";
160 Z=C:GOSUB 300
170 END
300 FOR I%=0 TO 7
310 PRINT PEEK(VARPTR(Z)+I%);
320 NEXT I%
330 PRINT
340 RETURN
