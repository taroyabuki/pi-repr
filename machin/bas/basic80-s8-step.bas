10 S#=0#
20 FOR K%=11 TO 9 STEP -1
30 S#=1#/(2#*K%+1#)-.04#*S#
40 NEXT K%
50 PRINT "S9";
60 Z#=S#
70 GOSUB 300
80 A#=1#/17#
90 PRINT "A";
100 Z#=A#
110 GOSUB 300
120 B#=.04#*S#
130 PRINT "B";
140 Z#=B#
150 GOSUB 300
160 C#=A#-B#
170 PRINT "C";
180 Z#=C#
190 GOSUB 300
200 SYSTEM
300 T$=MKD$(Z#)
310 FOR I%=1 TO 8
320 PRINT ASC(MID$(T$,I%,1));
330 NEXT I%
340 PRINT
350 RETURN
