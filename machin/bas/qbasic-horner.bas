10 OPEN "OUT.TXT" FOR OUTPUT AS #1
20 B#=4*ATN(1#)
30 K=12:X#=1#/5#:GOSUB 300:U#=Y#
40 K=3:X#=1#/239#:GOSUB 300:V#=Y#
50 A#=16#*U#-4#*V#
60 PRINT #1,"ASYMMETRIC";A#
70 PRINT #1,A#-B#
80 GOSUB 900
90 K=23:X#=5#/11#:GOSUB 300:U#=Y#
100 K=18:X#=3#/8#:GOSUB 300:V#=Y#
110 A#=4#*U#+4#*V#
120 PRINT #1,"RATIONAL2";A#
130 PRINT #1,A#-B#
140 GOSUB 900
150 K=23:X#=11#/54#:GOSUB 300:U#=Y#
160 K=89:X#=43#/65#:GOSUB 300:V#=Y#
170 A#=4#*U#+4#*V#
180 PRINT #1,"RATIONAL2ALL";A#
190 PRINT #1,A#-B#
200 GOSUB 900
210 CLOSE #1
220 SYSTEM
300 Y#=0#
310 FOR I=K TO 1 STEP -1
320 C#=1#:IF I MOD 2=0 THEN C#=-1#
330 Y#=C#/(2#*I-1#)+X#*X#*Y#
340 NEXT I
350 Y#=X#*Y#
360 RETURN
900 T$=MKD$(A#)
910 FOR I=1 TO 8
920 H$=HEX$(ASC(MID$(T$,I,1)))
930 IF LEN(H$)=1 THEN H$="0"+H$
940 PRINT #1,H$;" ";
950 NEXT I
960 PRINT #1,
970 RETURN
