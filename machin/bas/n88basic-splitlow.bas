10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B),&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0
80 G=0#
90 FOR N%=0 TO 30
100 S=0#
110 P=.2#
120 FOR K%=0 TO N%
130 S=S+P/(2#*K%+1#)
140 P=-.04#*P
150 NEXT K%
160 T=0#
170 Q=1#/239#
180 U=Q*Q
190 FOR K%=0 TO N%
200 T=T+Q/(2#*K%+1#)
210 Q=-U*Q
220 NEXT K%
230 M=16#*S-4#*T
240 D=M-B
250 A=D
260 IF A>=0# THEN 280
270 A=-A
280 IF F=0 THEN 310
290 IF A>=G THEN 330
300 R%=N%:E=D:G=A:W=M:GOTO 330
310 F=-1:R%=N%:E=D:G=A:W=M
330 NEXT N%
340 PRINT "SPLITLOW";R%
350 Z=W
360 GOSUB 900
370 PRINT E
380 END
900 V=VARPTR(Z)
910 PRINT PEEK(V),PEEK(V+1),PEEK(V+2),PEEK(V+3)
920 PRINT PEEK(V+4),PEEK(V+5),PEEK(V+6),PEEK(V+7)
930 RETURN
