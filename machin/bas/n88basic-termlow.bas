10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B),&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0
80 G=0#
90 FOR N%=0 TO 30
100 M=0#
110 P=.2#
120 Q=1#/239#
130 U=Q*Q
140 FOR K%=0 TO N%
150 M=M+16#*P/(2#*K%+1#)-4#*Q/(2#*K%+1#)
160 P=-.04#*P
170 Q=-U*Q
180 NEXT K%
190 D=M-B
200 A=D
210 IF A>=0# THEN 230
220 A=-A
230 IF F=0 THEN 260
240 IF A>=G THEN 280
250 R%=N%:E=D:G=A:W=M:GOTO 280
260 F=-1:R%=N%:E=D:G=A:W=M
280 NEXT N%
290 PRINT "TERMLOW";R%
300 Z=W
310 GOSUB 900
320 PRINT E
330 END
900 FOR I%=0 TO 7
910 PRINT PEEK(VARPTR(Z)+I%);
920 NEXT I%
930 PRINT
940 RETURN
