10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B),&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 GOSUB 1800
80 GOSUB 2300
90 END
900 FOR I%=0 TO 7
910 PRINT PEEK(VARPTR(Z)+I%);
920 NEXT I%
930 PRINT
940 RETURN
1800 F=0
1810 G=0#
1820 FOR N%=0 TO 30
1825 PRINT "SPLITLOW N=";N%
1830 S=0#
1840 P=.2#
1850 FOR K%=0 TO N%
1860 S=S+P/(2#*K%+1#)
1870 P=-.04#*P
1880 NEXT K%
1890 T=0#
1900 Q=1#/239#
1910 U=Q*Q
1920 FOR K%=0 TO N%
1930 T=T+Q/(2#*K%+1#)
1940 Q=-U*Q
1950 NEXT K%
1960 M=16#*S-4#*T
1970 D=M-B
1980 A=D
1985 IF A>=0# THEN 1990
1987 A=-A
1990 IF F<>0 THEN 2020
2000 F=-1:R%=N%:E=D:G=A:W=M:GOTO 2040
2020 IF A>=G THEN 2040
2030 R%=N%:E=D:G=A:W=M
2040 NEXT N%
2050 PRINT "SPLITLOW";R%
2060 Z=W
2070 GOSUB 900
2080 PRINT E
2090 RETURN
2300 F=0
2310 G=0#
2320 FOR N%=0 TO 30
2325 PRINT "SPLITHIGH N=";N%
2330 S=0#
2340 FOR K%=N% TO 0 STEP -1
2350 P=.2#
2360 IF K%=0 THEN 2400
2370 FOR J%=1 TO K%
2380 P=-.04#*P
2390 NEXT J%
2400 S=S+P/(2#*K%+1#)
2410 NEXT K%
2420 T=0#
2430 FOR K%=N% TO 0 STEP -1
2440 Q=1#/239#
2450 U=Q*Q
2460 IF K%=0 THEN 2500
2470 FOR J%=1 TO K%
2480 Q=-U*Q
2490 NEXT J%
2500 T=T+Q/(2#*K%+1#)
2510 NEXT K%
2540 M=16#*S-4#*T
2550 D=M-B
2560 A=D
2570 IF A>=0# THEN 2590
2580 A=-A
2590 IF F<>0 THEN 2620
2600 F=-1:R%=N%:E=D:G=A:W=M:GOTO 2640
2620 IF A>=G THEN 2640
2630 R%=N%:E=D:G=A:W=M
2640 NEXT N%
2650 PRINT "SPLITHIGH";R%
2660 Z=W
2670 GOSUB 900
2680 PRINT E
2690 RETURN
