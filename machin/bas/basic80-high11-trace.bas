10 B#=3.14159265358979#
20 POKE VARPTR(B#),&HC2
30 N%=11
40 S#=0#
50 FOR K%=N% TO 0 STEP -1
60 S#=1#/(2#*K%+1#)-.04#*S#
65 Z#=S#
70 PRINT "S";K%;
80 GOSUB 900
90 NEXT K%
100 X#=1#/239#
110 U#=X#*X#
120 T#=0#
130 FOR K%=N% TO 0 STEP -1
140 T#=1#/(2#*K%+1#)-U#*T#
145 Z#=T#
150 PRINT "T";K%;
160 GOSUB 900
170 NEXT K%
180 M#=16#*.2#*S#-4#*X#*T#
190 PRINT "M";
200 Z#=M#
210 GOSUB 900
220 SYSTEM
900 T$=MKD$(Z#)
910 FOR I%=1 TO 8
920 PRINT ASC(MID$(T$,I%,1));
930 NEXT I%
940 PRINT
950 RETURN
