10 B#=3.14159265358979#
20 POKE VARPTR(B#),&HC2
30 PRINT "BEST"
40 Z#=B#
50 GOSUB 900
60 L%=-1
70 FOR N%=0 TO 30
80 S#=0#
90 P#=.2#
100 FOR K%=0 TO N%
110 S#=S#+P#/(2#*K%+1#)
120 P#=-.04#*P#
130 NEXT K%
140 T#=0#
150 Q#=1#/239#
160 U#=Q#*Q#
170 FOR K%=0 TO N%
180 T#=T#+Q#/(2#*K%+1#)
190 Q#=-U#*Q#
200 NEXT K%
210 M#=16#*S#-4#*T#
220 IF B#<>M# THEN 240
230 L%=N%:GOTO 250
240 NEXT N%
250 IF L%<0 THEN 270
260 PRINT "LOW";L%:GOTO 280
270 PRINT "LOW NONE"
280 Z#=M#
290 GOSUB 900
300 H%=-1
310 FOR N%=0 TO 30
320 S#=0#
330 FOR K%=N% TO 0 STEP -1
340 S#=1#/(2#*K%+1#)-.04#*S#
350 NEXT K%
360 X#=1#/239#
370 U#=X#*X#
380 T#=0#
390 FOR K%=N% TO 0 STEP -1
400 T#=1#/(2#*K%+1#)-U#*T#
410 NEXT K%
420 M#=16#*.2#*S#-4#*X#*T#
430 IF B#<>M# THEN 450
440 H%=N%:GOTO 460
450 NEXT N%
460 IF H%<0 THEN 480
470 PRINT "HIGH";H%:GOTO 490
480 PRINT "HIGH NONE"
490 Z#=M#
500 GOSUB 900
510 SYSTEM
900 T$=MKD$(Z#)
910 FOR I%=1 TO 8
920 PRINT ASC(MID$(T$,I%,1));
930 NEXT I%
940 PRINT
950 RETURN
