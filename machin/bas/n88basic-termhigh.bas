10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B),&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0
80 G=0#
90 FOR N%=0 TO 30
100 P=.2#
110 Q=1#/239#
120 U=Q*Q
130 FOR J%=1 TO N%
140 P=-.04#*P
150 Q=-U*Q
160 NEXT J%
170 M=0#
180 FOR K%=N% TO 0 STEP -1
190 M=M+16#*P/(2#*K%+1#)-4#*Q/(2#*K%+1#)
200 IF K%=0 THEN 220
210 P=-25#*P:Q=-Q/U
220 NEXT K%
230 D=M-B
240 A=D
250 IF A>=0# THEN 270
260 A=-A
270 IF F=0 THEN 300
280 IF A>=G THEN 320
290 R%=N%:E=D:G=A:W=M:GOTO 320
300 F=-1:R%=N%:E=D:G=A:W=M
320 NEXT N%
330 PRINT "TERMHIGH";R%
340 Z=W
350 GOSUB 900
360 PRINT E
370 END
900 V=VARPTR(Z)
910 PRINT PEEK(V),PEEK(V+1),PEEK(V+2),PEEK(V+3)
920 PRINT PEEK(V+4),PEEK(V+5),PEEK(V+6),PEEK(V+7)
930 RETURN
