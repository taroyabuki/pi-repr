40 Y=16*U-4*V
50 K=23:A=5/11:GOSUB 200:U=R
60 K=18:A=3/8:GOSUB 200:V=R
70 Z=4*U+4*V
80 K=23:A=11/54:GOSUB 200:U=R
90 K=89:A=43/65:GOSUB 200:V=R
100 W=4*U+4*V
