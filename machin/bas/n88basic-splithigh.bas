10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B),&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0
80 G=0#
90 FOR N%=0 TO 30
100 P=.2#
110 FOR J%=1 TO N%
120 P=-.04#*P
130 NEXT J%
140 S=0#
150 FOR K%=N% TO 0 STEP -1
160 S=S+P/(2#*K%+1#)
170 IF K%=0 THEN 190
180 P=-25#*P
190 NEXT K%
200 Q=1#/239#
210 U=Q*Q
220 FOR J%=1 TO N%
230 Q=-U*Q
240 NEXT J%
250 T=0#
260 FOR K%=N% TO 0 STEP -1
270 T=T+Q/(2#*K%+1#)
280 IF K%=0 THEN 300
290 Q=-Q/U
300 NEXT K%
310 M=16#*S-4#*T
320 D=M-B
330 A=D
340 IF A>=0# THEN 360
350 A=-A
360 IF F=0 THEN 390
370 IF A>=G THEN 410
380 R%=N%:E=D:G=A:W=M:GOTO 410
390 F=-1:R%=N%:E=D:G=A:W=M
410 NEXT N%
420 PRINT "SPLITHIGH";R%
430 Z=W
440 GOSUB 900
450 PRINT E
460 END
900 V=VARPTR(Z)
910 PRINT PEEK(V),PEEK(V+1),PEEK(V+2),PEEK(V+3)
920 PRINT PEEK(V+4),PEEK(V+5),PEEK(V+6),PEEK(V+7)
930 RETURN
