10 B#=3.14159265358979#
20 POKE VARPTR(B#),&HC2
30 R#=1#/25#
40 PRINT "BEST"
50 Z#=B#
60 GOSUB 900
70 L=-1
80 FOR N=0 TO 30
90 S#=0#
100 P#=.2#
110 FOR K=0 TO N
120 S#=S#+P#/(2*K+1)
130 P#=-R#*P#
140 NEXT K
150 T#=0#
160 Q#=1#/239#
170 U#=Q#*Q#
180 FOR K=0 TO N
190 T#=T#+Q#/(2*K+1)
200 Q#=-U#*Q#
210 NEXT K
220 M#=16#*S#-4#*T#
230 IF B#<>M# THEN 250
240 L=N:GOTO 260
250 NEXT N
260 IF L<0 THEN 280
270 PRINT "LOW";L:GOTO 290
280 PRINT "LOW NONE"
290 Z#=M#
300 GOSUB 900
310 H=-1
320 FOR N=0 TO 30
330 S#=0#
340 FOR K=N TO 0 STEP -1
350 S#=1#/(2*K+1)-R#*S#
360 NEXT K
370 X#=1#/239#
380 U#=X#*X#
390 T#=0#
400 FOR K=N TO 0 STEP -1
410 T#=1#/(2*K+1)-U#*T#
420 NEXT K
430 M#=16#*.2#*S#-4#*X#*T#
440 IF B#<>M# THEN 460
450 H=N:GOTO 470
460 NEXT N
470 IF H<0 THEN 490
480 PRINT "HIGH";H:GOTO 500
490 PRINT "HIGH NONE"
500 Z#=M#
510 GOSUB 900
520 SYSTEM
900 T$=MKD$(Z#)
910 FOR I=1 TO 8
920 PRINT ASC(MID$(T$,I,1));
930 NEXT I
940 PRINT
950 RETURN
