10 DEFDBL A-H,N-Z
20 K=12:X=1#/5#:GOSUB 300:U=Y
30 K=3:X=1#/239#:GOSUB 300:V=Y
40 A=16#*U-4#*V
50 B=4#*ATN(1#)
60 PRINT "ASYMMETRIC";A
70 PRINT A-B
80 GOSUB 900
90 K=23:X=5#/11#:GOSUB 300:U=Y
100 K=18:X=3#/8#:GOSUB 300:V=Y
110 A=4#*U+4#*V
120 PRINT "RATIONAL2";A
130 PRINT A-B
140 GOSUB 900
150 K=23:X=11#/54#:GOSUB 300:U=Y
160 K=89:X=43#/65#:GOSUB 300:V=Y
170 A=4#*U+4#*V
180 PRINT "RATIONAL2ALL";A
