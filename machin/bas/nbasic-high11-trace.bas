10 DEFDBL A-Z
20 N=11
30 S=0#
40 FOR K=N TO 0 STEP -1
50 S=1#/(2#*K+1#)-.04#*S
60 PRINT "S";K;
70 Z=S:GOSUB 200
80 NEXT K
90 X=1#/239#
100 U=X*X
110 T=0#
120 FOR K=N TO 0 STEP -1
130 T=1#/(2#*K+1#)-U*T
140 PRINT "T";K;
150 Z=T:GOSUB 200
160 NEXT K
170 M=16#*.2#*S-4#*X*T
180 PRINT "M";
190 Z=M:GOSUB 200
195 END
200 FOR I%=0 TO 7
210 PRINT PEEK(VARPTR(Z)+I%);
220 NEXT I%
230 PRINT
240 RETURN
