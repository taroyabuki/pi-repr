10 S#=0#
20 FOR K%=11 TO 9 STEP -1
30 S#=1#/(2#*K%+1#)-.04#*S#
40 NEXT K%
50 R#=.04#
60 POKE VARPTR(R#),215
70 PRINT "S9";
80 Z#=S#
90 GOSUB 300
100 PRINT "R";
110 Z#=R#
120 GOSUB 300
130 B#=R#*S#
140 PRINT "B";
150 Z#=B#
160 GOSUB 300
170 A#=1#/17#
180 C#=A#-B#
190 PRINT "C";
200 Z#=C#
210 GOSUB 300
220 SYSTEM
300 T$=MKD$(Z#)
310 FOR I%=1 TO 8
320 PRINT ASC(MID$(T$,I%,1));
330 NEXT I%
340 PRINT
350 RETURN
