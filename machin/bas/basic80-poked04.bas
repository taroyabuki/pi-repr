10 B#=3.14159265358979#
20 POKE VARPTR(B#),&HC2
30 R#=.04#
40 POKE VARPTR(R#),215
50 PRINT "BEST"
60 Z#=B#
70 GOSUB 900
80 L=-1
90 FOR N=0 TO 30
100 S#=0#
110 P#=.2#
120 FOR K=0 TO N
130 S#=S#+P#/(2*K+1)
140 P#=-R#*P#
150 NEXT K
160 T#=0#
170 Q#=1#/239#
180 U#=Q#*Q#
190 FOR K=0 TO N
200 T#=T#+Q#/(2*K+1)
210 Q#=-U#*Q#
220 NEXT K
230 M#=16#*S#-4#*T#
240 IF B#<>M# THEN 260
250 L=N:GOTO 270
260 NEXT N
270 IF L<0 THEN 290
280 PRINT "LOW";L:GOTO 300
290 PRINT "LOW NONE"
300 Z#=M#
310 GOSUB 900
320 H=-1
330 FOR N=0 TO 30
340 S#=0#
350 FOR K=N TO 0 STEP -1
360 S#=1#/(2*K+1)-R#*S#
370 NEXT K
380 X#=1#/239#
390 U#=X#*X#
400 T#=0#
410 FOR K=N TO 0 STEP -1
420 T#=1#/(2*K+1)-U#*T#
430 NEXT K
440 M#=16#*.2#*S#-4#*X#*T#
450 IF B#<>M# THEN 470
460 H=N:GOTO 480
470 NEXT N
480 IF H<0 THEN 500
490 PRINT "HIGH";H:GOTO 510
500 PRINT "HIGH NONE"
510 Z#=M#
520 GOSUB 900
530 SYSTEM
900 T$=MKD$(Z#)
910 FOR I=1 TO 8
920 PRINT ASC(MID$(T$,I,1));
930 NEXT I
940 PRINT
950 RETURN
