10 A=3.1415927:Q=1
20 P=INT(A*Q+.5):T=P/Q-A:IF T<0 THEN T=-T
30 IF T=0 THEN PRINT"FOUND";P;"/";Q;"D";0:END
40 S=1:GOSUB 100:S=-1:GOSUB 100
50 IF Q/1000=INT(Q/1000) THEN PRINT"Q";Q
60 Q=Q+1:IF Q<=29712 THEN GOTO 20
70 END
100 D=1:W=0:C=0
110 E=(P+S*D)/Q-A:IF E<0 THEN E=-E
120 IF E=0 THEN PRINT"FOUND";P+S*D;"/";Q;"D";S*D:END
130 IF W<>0 THEN 160
140 IF E<=T THEN D=D+1:GOTO 110
150 W=1:C=2:B=T
160 IF E<B THEN PRINT"ANOM";Q;"D";S*D;T;E:END
170 C=C-1:IF C=0 THEN RETURN
180 D=D+1:GOTO 110
