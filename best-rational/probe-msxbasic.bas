10 A#=4#*ATN(1#)
20 Q=1
30 IF Q/10000=INT(Q/10000) THEN PRINT "Q";Q
40 P=INT(A#*Q+.5)
50 T=ABS(P/Q-A#)
60 E0=T
70 IF E0=0 THEN PRINT "FOUND ";P;"/";Q;" D ";0:END
80 S=1
90 GOSUB 300
100 S=-1
110 GOSUB 300
120 Q=Q+1
130 GOTO 30
300 D=1
310 W=0
320 C=0
330 T=ABS((P+S*D)/Q-A#)
340 E=T
350 IF E=0 THEN PRINT "FOUND ";P+S*D;"/";Q;" D ";S*D:END
360 IF W THEN 420
370 X=SGN(E-E0)
380 IF X=-1 THEN D=D+1:GOTO 330
390 IF X=0 THEN D=D+1:GOTO 330
400 W=1
410 C=2
415 BEST=E0
420 X=SGN(E-BEST)
430 IF X=-1 THEN PRINT "ANOM ";Q;" D ";S*D;" ";E0;" ";E:END
440 C=C-1
450 IF C=0 THEN RETURN
460 D=D+1
470 GOTO 330
