10 A=4*ATN(1)
20 Q=1
30 IF Q/1000=INT(Q/1000) THEN PRINT "Q";Q
40 P=INT(A*Q+.5)
50 T=P/Q-A
55 IF T<0 THEN T=-T
57 E0=T
60 IF E0=0 THEN PRINT "FOUND";P;"/";Q;"D";0:END
70 S=1:GOSUB 200
80 S=-1:GOSUB 200
90 Q=Q+1
100 GOTO 30
200 D=1:W=0:C=0
210 T=(P+S*D)/Q-A
215 IF T<0 THEN T=-T
217 E=T
220 IF E=0 THEN PRINT "FOUND";P+S*D;"/";Q;"D";S*D:END
230 IF W<>0 THEN 240
232 IF E<=E0 THEN D=D+1:GOTO 210
234 W=1:C=2:BEST=E0
240 IF E<BEST THEN PRINT "ANOM";Q;"D";S*D;E0;E:END
260 C=C-1
270 IF C=0 THEN RETURN
280 D=D+1
290 GOTO 210
