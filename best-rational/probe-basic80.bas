330 IF W<>0 THEN 340
332 IF E<=E0 THEN D=D+1:GOTO 310
334 W=1:C=2:BEST=E0
340 IF E<BEST THEN PRINT "ANOM ";Q;" D ";S*D;" ";E0;" ";E:END
