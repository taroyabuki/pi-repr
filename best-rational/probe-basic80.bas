100 DEFDBL A-Z
110 A#=657408909#/209259755#
120 Q=1
130 IF Q/100000=INT(Q/100000) THEN PRINT "Q";Q
140 P=INT(A#*Q+.5)
150 T=P/Q-A#
155 IF T<0 THEN T=-T
157 E0=T
160 IF E0=0 THEN PRINT "FOUND ";P;"/";Q;" D ";0:END
170 S=1:GOSUB 300
180 S=-1:GOSUB 300
