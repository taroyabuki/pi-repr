100 REM ***** PAI
110  DEFDBL X,Y,Z
120  K=9
130  X=.2#
140  GOSUB 190
150  Z=Y
160  X=1#/239#
170  GOSUB 190
180  PRINT 16*Z-4*Y
181  DEFDBL A:A=16*Z-4*Y:P=VARPTR(A)
182  FOR I=0 TO 7
183    PRINT RIGHT$("0"+HEX$(PEEK(P+I)),2);" ";
184  NEXT
185  END
190 REM *** arctan
200  Y=0
210  FOR I=K TO 1 STEP -1
220    J=2*I-1
221    GOSUB 260
222    IF I MOD 2 =0 GOTO 235
230    Y=Y+P/J:GOTO 240
235    Y=Y-P/J
240  NEXT I
250 RETURN
260 REM *** power P=X^J
270  P=X
280  IF J=1 THEN RETURN
290  FOR W=2 TO J
300    P=P*X
310  NEXT
320 RETURN
