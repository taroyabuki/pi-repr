100 REM ***** FRACT2 1986.9.1
110  DEFDBL A,D,E,L,M,N,X,Y,Z
120  K=11
130  X=.2#
140  GOSUB 200
150  Z=Y
160  X=.00418410041841#
170  GOSUB 200
180  A=16*Z-4*Y
190  GOTO 290
200 REM *** arctan
210  Y=0
220  FOR I=1 TO K
230    J=2*I-1
240    IF I MOD 2 =0 GOTO 260
250    Y=Y+X^J/J:GOTO 270
260    Y=Y-X^J/J
270  NEXT I
280  RETURN
290 REM ***** Fraction
300  N=1:D=1
310  L=A*N
320  M=INT(L)
330  IF M+1-L<L-M THEN M=M+1
340  E=ABS(A-M/N)
350  IF E>=D GOTO 380
360  PRINT M;"/";N,M/N
365  IF E=0 THEN END
370  D=E
380  N=N+1
390  GOTO 310
