10 X=3.1415927
20 Z=0
30 F=0
40 G=0
50 FOR N=0 TO 6
60 A=1
70 C=1/SQR(2)
80 T=.25
90 P=1
100 FOR I=1 TO N
110 U=(A+C)/2
120 D=A-U
130 C=SQR(A*C)
140 T=T-P*D*D
150 A=U
160 P=2*P
170 NEXT I
180 S=A+C
190 M=S*S/(4*T)
200 D=M-X
210 A1=D
220 IF A1>=0 THEN 240
230 A1=-A1
240 IF F<>0 THEN 270
250 F=-1:R=N:E=D:G=A1:Z=M:GOTO 290
270 IF A1>=G THEN 290
280 R=N:E=D:G=A1:Z=M
290 NEXT N
300 PRINT "AGM";R
310 PRINT E
320 END
