10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B)+7,&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0
80 G=0#
90 FOR N%=0 TO 6
100 A=1#
110 C=1#/SQR(2#)
120 T=.25#
130 P=1#
140 FOR I%=1 TO N%
150 U=(A+C)/2#
160 D=A-U
170 C=SQR(A*C)
180 T=T-P*D*D
190 A=U
200 P=2#*P
210 NEXT I%
220 S=A+C
230 M=S*S/(4#*T)
240 D=M-B
250 A1=ABS(D)
260 IF F<>0 THEN 290
270 F=-1:R=N%:E=D:G=A1:W=M:GOTO 310
290 IF A1>=G THEN 310
300 R=N%:E=D:G=A1:W=M
310 NEXT N%
320 PRINT "AGM";R
330 Z=W
340 GOSUB 900
350 PRINT "DIFF";E
360 END
900 V=VARPTR(Z)+7
910 PRINT PEEK(V),PEEK(V-1),PEEK(V-2),PEEK(V-3)
920 PRINT PEEK(V-4),PEEK(V-5),PEEK(V-6),PEEK(V-7)
930 RETURN
