10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B),&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0
80 G=0#
90 FOR N%=0 TO 6
100 A=1#
110 C=1#/SQR(2#)
120 T=.25#
130 P=1#
140 FOR I%=1 TO N%
150 U=(A+C)/2#
160 D=A-U
170 C=SQR(A*C)
180 T=T-P*D*D
190 A=U
200 P=2#*P
210 NEXT I%
220 S=A+C
230 M=S*S/(4#*T)
240 D=M-B
250 A1=D
260 IF A1>=0# THEN 280
270 A1=-A1
280 IF F<>0 THEN 310
290 F=-1:R%=N%:E=D:G=A1:W=M:GOTO 330
310 IF A1>=G THEN 330
320 R%=N%:E=D:G=A1:W=M
330 NEXT N%
340 PRINT "AGM";R%
350 Z=W
360 GOSUB 900
370 PRINT E
380 END
900 FOR I%=0 TO 7
910 PRINT PEEK(VARPTR(Z)+I%);
920 NEXT I%
930 PRINT
940 RETURN
