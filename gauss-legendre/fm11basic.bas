10 DEFDBL A-Z
20 B=3.14159265358979#
30 POKE VARPTR(B)+7,&HC2
40 PRINT "BEST"
50 Z=B
60 GOSUB 900
70 F=0:G=0#
80 FOR N%=0 TO 6
90 A=1#
100 C=1#/SQR(2#)
110 T=.25#
120 P=1#
130 FOR I%=1 TO N%
140 U=(A+C)/2#
150 D=A-U
160 C=SQR(A*C)
170 T=T-P*D*D
180 A=U
190 P=2#*P
200 NEXT I%
210 S=A+C
220 M=S*S/(4#*T)
230 D=M-B
240 A1=ABS(D)
250 IF F=0 THEN 280
260 IF A1>=G THEN 300
270 R%=N%:E=D:G=A1:W=M
280 IF F<>0 THEN 300
290 F=-1:R%=N%:E=D:G=A1:W=M
300 NEXT N%
310 PRINT "AGM";R%
320 Z=W
330 GOSUB 900
340 PRINT "DIFF";E
350 END
900 V=VARPTR(Z)+7
910 PRINT PEEK(V),PEEK(V-1),PEEK(V-2),PEEK(V-3)
920 PRINT PEEK(V-4),PEEK(V-5),PEEK(V-6),PEEK(V-7)
930 RETURN
