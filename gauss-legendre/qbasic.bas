10 OPEN "OUT.TXT" FOR OUTPUT AS #1
20 B#=4*ATN(1)
30 PRINT #1,"BEST"
40 Z#=B#
50 GOSUB 900
60 F=0
70 G#=0#
80 FOR N=0 TO 6
90 A#=1#
100 C#=1#/SQR(2#)
110 T#=.25#
120 P#=1#
130 FOR I=1 TO N
140 U#=(A#+C#)/2#
150 D#=A#-U#
160 C#=SQR(A#*C#)
170 T#=T#-P#*D#*D#
180 A#=U#
190 P#=2#*P#
200 NEXT I
210 S#=A#+C#
220 M#=S#*S#/(4#*T#)
230 D#=M#-B#
240 A1#=ABS(D#)
250 IF F<>0 THEN 280
260 F=-1:R=N:E#=D#:G#=A1#:W#=M#:GOTO 300
280 IF A1#>=G# THEN 300
290 R=N:E#=D#:G#=A1#:W#=M#
300 NEXT N
310 PRINT #1,"AGM";R
320 Z#=W#
330 GOSUB 900
340 PRINT #1,E#
350 CLOSE #1
360 SYSTEM
900 T$=MKD$(Z#)
910 FOR I=1 TO 8
920 PRINT #1,ASC(MID$(T$,I,1));
930 NEXT I
940 PRINT #1,
950 RETURN
