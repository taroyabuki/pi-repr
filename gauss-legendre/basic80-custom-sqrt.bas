10 B#=3.14159265358979#
20 POKE VARPTR(B#),&HC2
30 PRINT "BEST"
40 Z#=B#
50 GOSUB 900
60 FOR V=0 TO 1
70 F=0
80 G#=0#
85 O=0
90 FOR N=0 TO 6
100 A#=1#
110 IF V=0 THEN 150
120 X#=2#
