480 SYSTEM
900 T$=MKD$(Z#)
910 FOR I=1 TO 8
920 PRINT ASC(MID$(T$,I,1));
930 NEXT I
940 PRINT
950 RETURN
1000 Y#=X#
1010 IF Y#>=1# THEN 1030
1020 Y#=1#
1030 Q#=0#
1040 FOR J=1 TO 64
1050 H#=(Y#+X#/Y#)/2#
1060 IF H#=Y# THEN Y#=H#:RETURN
1070 IF J=1 THEN 1100
1080 IF H#<>Q# THEN 1100
1090 O=O+1:Y#=H#:RETURN
1100 Q#=Y#
1110 Y#=H#
1120 NEXT J
1130 RETURN
