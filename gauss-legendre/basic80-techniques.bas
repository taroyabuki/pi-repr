10 B#=3.14159265358979#
20 POKE VARPTR(B#),&HC2
30 PRINT "BEST"
40 Z#=B#
50 GOSUB 900
60 FOR V=0 TO 3
70 F=0
80 G#=0#
90 FOR N=0 TO 8
100 A#=1#
110 C#=1#/SQR(2#)
120 T#=.25#
130 P#=1#
140 FOR I=1 TO N
150 U#=(A#+C#)/2#
160 D#=A#-U#
170 C#=SQR(A#*C#)
180 IF V<2 THEN 210
190 T#=T#-(P#*D#)*D#
200 GOTO 220
210 T#=T#-P#*D#*D#
220 A#=U#
230 P#=2#*P#
240 NEXT I
250 IF V<2 THEN 280
260 S#=(A#+C#)/2#
270 M#=S#*S#/T#:GOTO 300
280 S#=A#+C#
290 M#=S#*S#/(4#*T#)
300 D#=M#-B#
310 A1#=ABS(D#)
320 IF F<>0 THEN 350
330 F=-1:R=N:E#=D#:G#=A1#:W#=M#:GOTO 370
350 IF A1#>=G# THEN 370
360 R=N:E#=D#:G#=A1#:W#=M#
370 NEXT N
380 IF V=0 THEN PRINT "PLAIN";R:GOTO 420
390 IF V=1 THEN PRINT "TSPLIT";R:GOTO 420
400 IF V=2 THEN PRINT "FHALF";R:GOTO 420
410 PRINT "COMBO";R
420 Z#=W#
430 GOSUB 900
440 PRINT E#
450 NEXT V
460 SYSTEM
900 T$=MKD$(Z#)
910 FOR I=1 TO 8
920 PRINT ASC(MID$(T$,I,1));
930 NEXT I
940 PRINT
950 RETURN
