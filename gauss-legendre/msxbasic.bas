10 B#=4#*ATN(1#)
20 PRINT "BEST"
30 Z#=B#
40 GOSUB 900
50 F=0
60 G#=0#
70 FOR N=0 TO 6
80 A#=1#
90 C#=1#/SQR(2#)
100 T#=.25#
110 P#=1#
120 FOR I=1 TO N
130 U#=(A#+C#)/2#
140 D#=A#-U#
150 C#=SQR(A#*C#)
160 T#=T#-P#*D#*D#
170 A#=U#
180 P#=2#*P#
190 NEXT I
200 S#=A#+C#
210 M#=S#*S#/(4#*T#)
220 D#=M#-B#
230 A1#=ABS(D#)
240 IF F=0 THEN 270
250 IF A1#>=G# THEN 290
260 R=N:E#=D#:G#=A1#:W#=M#:GOTO 290
270 F=-1:R=N:E#=D#:G#=A1#:W#=M#
290 NEXT N
300 PRINT "AGM";R
310 Z#=W#
320 GOSUB 900
330 PRINT E#
340 END
900 FOR I=0 TO 7
910 PRINT PEEK(VARPTR(Z#)+I);
920 NEXT I
930 PRINT
940 RETURN
